<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:resizeableActivity="true"
        android:theme="@style/Theme.MacRemote">
        <!-- 小米 Flip 外屏：内外屏切换时界面接续（见小米澎湃OS《竖折手机（Flip）适配说明》） -->
        <meta-data android:name="android.supports_size_changes" android:value="true" />
        <meta-data android:name="miui.supportAppContinuity" android:value="true" />
        <property android:name="miui.continuity.policy" android:value="5" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <!-- 小米 Flip 外屏：continuity.policy=5 表示支持在外屏启动 -->
            <property android:name="miui.continuity.policy" android:value="5" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
